<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>authz-queryplan-jpa</artifactId>
    <packaging>jar</packaging>

    <name>Labs64.IO :: AuthZ Query-Plan (JPA)</name>
    <description>Translates a Cerbos PlanResources query plan into a Spring Data JPA Specification (Data PEP)</description>
    <url>https://labs64.io</url>

    <parent>
        <groupId>io.labs64</groupId>
        <artifactId>labs64io-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../labs64io-parent/pom.xml</relativePath>
    </parent>

    <properties>
        <!-- Library targets 17 so every ecosystem service (Java >= 17) can consume it -->
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- The engine-neutral QueryPlan/PlanExpr SPI + AuthorizationException -->
        <dependency>
            <groupId>io.labs64</groupId>
            <artifactId>auth-context-spring-boot-starter</artifactId>
        </dependency>
        <!-- JPA + Spring Data provided by the consuming service at runtime -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-jpa</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
