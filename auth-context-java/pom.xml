<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.labs64</groupId>
        <artifactId>labs64io-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../labs64io-parent/pom.xml</relativePath>
    </parent>

    <artifactId>auth-context-java-parent</artifactId>
    <packaging>pom</packaging>

    <name>Labs64.IO :: Auth Context :: Java</name>
    <description>Java reactor for the transport-neutral auth-context core and Spring Boot integration</description>
    <url>https://labs64.io</url>

    <modules>
        <module>auth-context-core</module>
        <module>auth-context-spring-boot-starter</module>
    </modules>

    <properties>
        <!-- Library targets 17 so every ecosystem service (Java >= 17) can consume it -->
        <java.version>17</java.version>
        <cerbos-sdk.version>0.20.1</cerbos-sdk.version>
    </properties>
</project>
